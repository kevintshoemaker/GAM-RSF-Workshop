density ~ s(depth, k = 5),
data = pcod,
mesh = mesh,
time = "year",
family = tweedie(link = "log"),
spatial = "off",
spatiotemporal = "ar1"   # can also be 'iid' or 'rw' (or 'off')
)
table(pcod$year)
fit_spatiotemporal
